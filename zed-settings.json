// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "language_models": {
    "opencode": {
      "show_go_models": true,
      "show_zen_models": true
    }
  },
  "redact_private_values": true,
  "agent": {
    "cancel_generation_on_terminal_stop": false,
    "thinking_display": "preview",
    "sandbox_permissions": {
      "network_hosts": [
        "platform.openai.com",
        "zed.dev",
        "developers.openai.com"
      ]
    },
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://platform\\.openai\\.com"
            }
          ]
        }
      }
    },
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6-astra",
      "enable_thinking": true,
      "effort": "max"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "accessible_mode": true,
  "ssh_connections": [
    {
      "host": "francis-vm",
      "args": [],
      "projects": []
    }
  ],
  "wsl_connections": [
    {
      "distro_name": "Ubuntu",
      "user": null,
      "projects": []
    }
  ],
  "edit_predictions": {
    "allow_data_collection": "yes",
    "codestral": {
      "model": "codestral-latest"
    },
    "open_ai_compatible_api": {
      "model": ""
    },
    "ollama": {
      "api_url": "http://127.0.0.1:11434"
    },
    "provider": "copilot"
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "ultra",
        "mode": "agent-full-access"
      },
      "type": "registry"
    },
    "factory-droid": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "model": "opus[1m]",
        "effort": "max",
        "mode": "auto"
      },
      "env": {
        "CLAUDE_CODE_ENABLE_CFC": "1"
      },
      "type": "registry"
    },
    "qwen-code": {
      "type": "registry"
    },
    "kilo": {
      "default_config_options": {
        "mode": "code",
        "model": "kilo/kilo-auto/free"
      },
      "type": "registry"
    },
    "antigravity-acp": {
      "default_config_options": {
        "mode": "yolo",
        "model": "gemini-3.8-flash-low"
      },
      "type": "registry"
    },
    "github-copilot-cli": {
      "default_config_options": {
        "reasoning_effort": "low",
        "mode": "https://agentclientprotocol.com/protocol/session-modes#autopilot",
        "allow_all": "on",
        "model": "claude-opus-5"
      },
      "type": "registry"
    }
  },
  "context_servers": {
    "mcp-server-playwright": {
      "command": "C:/Users/fvegi/AppData/Local/mise/shims/node.exe",
      "args": [
        "C:/Users/fvegi/.codex/zed-playwright-mcp/node_modules/@playwright/mcp/cli.js",
        "--headless",
        "--isolated",
        "--browser",
        "chromium"
      ],
      "env": {}
    },
    "mcp-server-github": {
      "command": "C:/Users/fvegi/AppData/Local/mise/shims/node.exe",
      "args": [
        "C:/Users/fvegi/.codex/repair-zed-mcp/github-launcher.mjs"
      ],
      "env": {}
    },
    "mcp-server-webflow": {
      "enabled": false
    },
    "cua-driver": {
      "command": "C:/Users/fvegi/.codex/cua-driver/0.28.1/cua-driver.exe",
      "args": [
        "mcp"
      ],
      "env": {}
    }
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "base_keymap": "VSCode",
  "autosave": "on_focus_change",
  "format_on_save": "off",
  "tabs": {
    "git_status": true
  },
  "terminal": {
    "shell": {
      "program": "pwsh"
    }
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Kanagawa Dragon"
  },
  "auto_install_extensions": {
    "git-firefly": true,
    "mcp-server-supabase": false,
    "powershell": true
  }
}
