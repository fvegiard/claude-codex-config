{
  "description": "Codex Companion configuration - work in place on system without temp repos",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-lifecycle-hook.mjs\" SessionStart",
            "timeout": 5,
            "env": {
              "CODEX_WORK_IN_PLACE": "true",
              "CODEX_NO_TEMP_REPOS": "true",
              "CODEX_INLINE_ANALYSIS": "true"
            }
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-lifecycle-hook.mjs\" SessionEnd",
            "timeout": 5,
            "env": {
              "CODEX_WORK_IN_PLACE": "true",
              "CODEX_NO_TEMP_REPOS": "true"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/stop-review-gate-hook.mjs\"",
            "timeout": 900,
            "env": {
              "CODEX_WORK_IN_PLACE": "true",
              "CODEX_CLEANUP_TEMP_REPOS": "true"
            }
          }
        ]
      }
    ]
  }
}
